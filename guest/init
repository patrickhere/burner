#!/bin/sh
# burner guest init (pid 1). everything here runs inside the VM.
# drives: vda base (ro), vdb scratch ext4 (rw), vdc job tar (raw, ro), vdd result tar (raw, rw)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

halt() {
    sync
    if command -v busybox >/dev/null 2>&1; then busybox reboot -f; fi
    reboot -f 2>/dev/null
    sleep 3; echo b > /proc/sysrq-trigger
}

# the tty the kernel was told to use, the last console= like the kernel's own
# pick: ttyS0 under firecracker, hvc0 (virtio console) under libkrun. a name
# that isn't a plain device here falls back to ttyS0
console_dev() {
    dev=$(sed -n 's/^/ /; s/.* console=\([A-Za-z0-9]*\).*/\1/p' "$1")
    if [ -z "$dev" ] || [ ! -c "/dev/$dev" ]; then dev=ttyS0; fi
    echo "$dev"
}

# burner shell: runs login shell $1 and waits for it. the shell runs under a
# small sh in a session of its own, which owns it: that sh checks it got the
# console as its controlling tty, says the shell is ready (token $3), runs it
# and puts its exit code in $2/rc, or why it couldn't in $2/fail. the shell's
# processes see this function's shell as pid 1, so poweroff, halt and reboot
# without -f signal it (busybox sends USR2, USR1 and TERM), which ends the
# wait with p or r in $2/how. a wrapper gone with none of those is lost
run_shell() {
    trap 'echo p > "$2/how"' USR1 USR2
    trap 'echo r > "$2/how"' TERM
    # setsid twice: the second one forks, so the wrapper gets a session of its
    # own with the console as its tty, and this one stays free to take those
    # signals. a shell started with & would ignore ctrl-c for good
    # shellcheck disable=SC2016
    if ! setsid setsid -c /bin/sh -c '
        echo $$ > "$2/pid"
        if ! { : < /dev/tty; } 2>/dev/null; then echo "no controlling tty" > "$2/fail"; exit 1; fi
        [ -n "$3" ] && printf "BURNER-%s-READY" "$3"
        "$1" -l
        echo $? > "$2/rc"' sh "$1" "$2" "$3"; then
        echo "setsid failed" > "$2/fail"
        return
    fi
    n=0
    while [ ! -s "$2/rc" ] && [ ! -s "$2/how" ] && [ ! -s "$2/fail" ]; do
        if [ -s "$2/pid" ]; then
            # pid 1 reaps the wrapper once it's gone, then kill -0 fails
            read -r pid < "$2/pid"
            kill -0 "$pid" 2>/dev/null || break
        elif [ "$n" -ge 50 ]; then
            echo "the shell never started" > "$2/fail"
        fi
        n=$((n + 1))
        sleep 0.2
    done
}

# pid 1 of the shell's own pid namespace. poweroff, halt and reboot with -f
# call reboot(2), which in a pid namespace ends only the namespace: pid 1
# outside sees this one die of SIGINT (poweroff, halt) or SIGHUP (reboot)
if [ "${1:-}" = shellns ]; then
    run_shell "$2" "$3" "$4"
    exit 0
fi

if [ "${1:-}" != stage2 ]; then
    mount -t proc proc /proc
    mount -t devtmpfs dev /dev 2>/dev/null
    if ! mount -t ext4 -o noatime /dev/vdb /overlay; then
        echo "burner-init: scratch mount failed" > /dev/console; halt
    fi
    mkdir -p /overlay/upper /overlay/work
    mount -t overlay overlay -o lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work /mnt || {
        echo "burner-init: overlay failed" > /dev/console; halt; }
    mkdir -p /mnt/rom
    cd /mnt || halt
    pivot_root . rom || { echo "burner-init: pivot failed" > /dev/console; halt; }
    exec /sbin/burner-init stage2
fi

# stage 2: on the overlay root
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
exec < /dev/console > /dev/console 2>&1
mkdir -p /dev/pts /tmp /run; mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null
umount -l /rom 2>/dev/null
hostname burner 2>/dev/null
dns=$(sed -n 's/.*burner\.dns=\([0-9.,]*\).*/\1/p' /proc/cmdline)
if [ -n "$dns" ]; then
    rm -f /etc/resolv.conf
    for ip in $(echo "$dns" | tr ',' ' '); do echo "nameserver $ip"; done > /etc/resolv.conf
fi

if grep -q 'burner\.shell=1' /proc/cmdline; then
    # interactive: a login shell on the console, the VM ends when it exits
    con=/dev/$(console_dev /proc/cmdline)
    # a tty, read and written both ways on purpose
    # shellcheck disable=SC2094
    exec < "$con" > "$con" 2>&1
    tty=$(sed -n 's/.*burner\.tty=\([0-9]*x[0-9]*\).*/\1/p' /proc/cmdline)
    [ -n "$tty" ] && stty rows "${tty%x*}" cols "${tty#*x}" 2>/dev/null
    # backspace in a line read (cat, read) takes a whole utf-8 char, not a byte
    stty iutf8 2>/dev/null
    # the caller's terminal size after a resize: burner rewrites the first line
    # of vdc (burner-tty SEQ ROWS COLS SEQ). setting it on the console sends
    # the shell's foreground job SIGWINCH
    (
        seen=0
        while sleep 0.5; do
            blockdev --flushbufs /dev/vdc 2>/dev/null
            read -r tag n r c m < /dev/vdc || continue
            [ "$tag" = burner-tty ] && [ "$n" = "$m" ] && [ "$n" != "$seen" ] || continue
            case "$r$c" in ''|*[!0-9]*) continue ;; esac
            seen=$n
            stty -F "$con" rows "$r" cols "$c" 2>/dev/null
        done
    ) &
    sizer=$!
    term=$(sed -n 's/.*burner\.term=\([a-z0-9.+-]*\).*/\1/p' /proc/cmdline)
    export TERM="${term:-xterm}" HOME=/root
    cd /root 2>/dev/null || cd /
    sh=/bin/sh; [ -x /bin/bash ] && sh=/bin/bash
    # shellcheck disable=SC1091
    name=$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-linux}")
    printf '\nburner: fresh %s VM. nothing is kept when you exit.\n\n' "$name"
    token=$(sed -n 's/.*burner\.token=\([A-Za-z0-9]*\).*/\1/p' /proc/cmdline)
    # burner holds the caller's keys until the shell says it's ready, so none
    # reach a console that isn't set up yet, and ctrl-c until then stops the VM
    st=/run/burner-shell
    rm -rf "$st"; mkdir -p "$st"
    if ! command -v setsid >/dev/null 2>&1; then
        # nothing here can give the shell a controlling tty
        echo "burner: this image has no setsid, so the shell gets no job control and ctrl-c can't stop what runs in it. ~. after enter still leaves"
        [ -n "$token" ] && printf 'BURNER-%s-READY' "$token"
        "$sh" -l; echo $? > "$st/rc"
    elif unshare -m -p -f --mount-proc true 2>/dev/null; then
        unshare -m -p -f --mount-proc /bin/sh /sbin/burner-init shellns "$sh" "$st" "$token"
        case $? in 129) echo r > "$st/how" ;; 130) echo p > "$st/how" ;; esac
    else
        # no pid namespaces: poweroff -f and the like stop the kernel here
        run_shell "$sh" "$st" "$token"
    fi
    kill "$sizer" 2>/dev/null
    # how the shell ended, as burner reads it: its exit code, p or r, f when it
    # couldn't start, l when it went away without an exit code
    how=$(cat "$st/how" 2>/dev/null); rc=$(cat "$st/rc" 2>/dev/null)
    if [ -n "$how" ]; then
        status=$how
    elif [ -s "$st/fail" ]; then
        echo "burner-init: the shell didn't start: $(cat "$st/fail")" > "$con"
        status=f
    else
        case $rc in ''|*[!0-9]*) status=l ;; *) status=$rc ;; esac
    fi
    dmesg -n 1 2>/dev/null
    # burner shows nothing past the end record, so the kernel's reboot line
    # (logged at a level no loglevel setting hides) doesn't end up on the
    # caller's terminal. $con is reopened: the login shell's exit hung up the
    # tty init's own fds point at
    [ -n "$token" ] && printf 'BURNER-%s-END%s;' "$token" "$status" > "$con"
    halt
fi

token=$(sed -n 's/.*burner\.token=\([A-Za-z0-9]*\).*/\1/p' /proc/cmdline)
# how this init talks to the host (console markers, /result layout). burner
# passes the one it speaks; an image from another burner version gets refused
PROTO=1
want=$(sed -n 's/.*burner\.proto=\([0-9]*\).*/\1/p' /proc/cmdline)
# seconds the job gets, a little under the VM's own time limit, so a job that
# runs long still hands back its log and /out before the host kills the VM
limit=$(sed -n 's/.*burner\.limit=\([0-9]*\).*/\1/p' /proc/cmdline)
mkdir -p /job /work /out /result
# rc and the log live in their own small tmpfs, so a full scratch disk can't lose
# them. the log never touches scratch at all: 64K head + 5 rolling 4M chunks
mount -t tmpfs -o size=40m,mode=0700 tmpfs /result || { echo "burner-init: /result tmpfs failed" > /dev/console; halt; }
C=/result/chunks; mkdir -p "$C"
echo "$PROTO" > /result/proto

# raw console: no \n -> \r\n, so the live bytes match the log exactly
stty -opost 2>/dev/null

fail() {   # sandbox-side failure before the command ran
    echo "BURNER-$token-BEGIN"; echo "burner: $1"; echo "BURNER-$token-END"
    echo "burner: $1" > /result/log.txt
    echo 125 > /result/rc
}

# reads the job's output from stdin: the first 64K to the console and /result/head,
# the rest into 4M chunks, keeping only the newest 5. prints the total byte count
# any failure goes in /result/error, which fails the run. the job's output is
# still drained so the job itself never gets SIGPIPE
capture() {
    # busybox ash has pipefail, plain posix sh doesn't. this only runs on busybox
    # shellcheck disable=SC3040
    set -o pipefail
    # one byte at a time so it streams as the job writes, and stops at exactly 64K
    # (busybox head -c reads past its count, a 64K block would wait for 64K)
    if ! dd bs=1 count=65536 2>/dev/null | tee /result/head; then
        echo "log capture failed" > /result/error
    fi
    total=$(wc -c < /result/head 2>/dev/null || echo 0)
    n=0
    while :; do
        if ! dd of="$C/$n" bs=1048576 count=4 iflag=fullblock 2>/dev/null; then
            echo "log capture failed" > /result/error
            cat > /dev/null
            break
        fi
        size=$(wc -c < "$C/$n" 2>/dev/null || echo 0)
        [ "$size" -gt 0 ] || { rm -f "$C/$n"; break; }
        rm -f "$C/$((n - 5))"
        total=$((total + size)); n=$((n + 1))
    done
    echo "$total $n" > /result/total
}

# the session id of a pid, from /proc/PID/stat. comm can hold spaces and ")",
# so everything up to the last ") " goes first
sid() {
    st=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    st=${st##*) }
    # shellcheck disable=SC2086
    set -- $st
    echo "$4"
}

# something the job left running in the background (a server, a daemon) still
# holds the output pipe, so capture would wait for it until the time limit.
# once the job has exited, everything outside init's own session goes. a few
# rounds, since a stray can fork while this looks
strays() {
    me=$(sid 1)
    for _ in 1 2 3; do
        for d in /proc/[0-9]*; do
            p=${d#/proc/}
            s=$(sid "$p") || continue
            # 0 is the kernel's own threads
            [ "$s" = "$me" ] || [ "$s" = 0 ] || kill -KILL "$p" 2>/dev/null
        done
    done
}

if [ "$want" != "$PROTO" ]; then
    fail "this image's guest init speaks protocol $PROTO and burner wants ${want:-none}, rebuild the image with tools/build-image"
elif ! tar -x -C /job -f /dev/vdc 2>/dev/null || [ ! -f /job/run.sh ]; then
    fail "job disk unreadable"
elif [ -f /job/input.tar ] && ! tar -x -C /work -f /job/input.tar 2>/result/untar.err; then
    fail "input tar did not unpack: $(head -c 300 /result/untar.err)"
else
    rm -f /job/input.tar /result/untar.err
    stdin=/dev/null; [ -f /job/stdin ] && stdin=/job/stdin
    cd /work || cd /
    export HOME=/root TERM=dumb LANG=C.UTF-8 BURNER=1
    echo "BURNER-$token-BEGIN"
    # the serial console is slow (nested virt), so only the first 64K goes out live.
    # the log goes back on the result disk and the host prints the rest
    # the job runs in its own session, so the watchdog can stop all of it
    if [ -n "$limit" ]; then
        (
            sleep "$limit"
            [ -f /result/rc ] && exit 0
            : > /result/timed_out
            pg=$(cat /result/jobpid 2>/dev/null)
            [ -n "$pg" ] || exit 0
            kill -TERM -"$pg" 2>/dev/null; sleep 3; kill -KILL -"$pg" 2>/dev/null
        ) &
        watchdog=$!
    fi
    # shellcheck disable=SC2016
    { setsid /bin/sh -c 'echo $$ > /result/jobpid; exec /bin/sh /job/run.sh' < "$stdin"; echo $? > /result/rc; strays; } 2>&1 | capture
    [ -n "${watchdog:-}" ] && kill "$watchdog" 2>/dev/null
    live=$(wc -c < /result/head 2>/dev/null || echo 0)
    read -r total n < /result/total 2>/dev/null || { total=0; n=0; }
    last=""
    [ "$live" -gt 0 ] && last=$(tail -c 1 /result/head | od -An -tx1 | tr -d ' \n')
    if [ "$live" -gt 0 ] && [ "$last" != 0a ]; then
        printf '\nBURNER-%s-ENDN\n' "$token"     # N: the newline before the marker is ours, not output
    else
        printf 'BURNER-%s-END\n' "$token"
    fi
    # the surviving chunks in order, after the head only if nothing between them
    # was dropped, cut to the last 16M
    i=$((n > 5 ? n - 5 : 0)); parts=""
    [ "$i" = 0 ] && parts=/result/head
    while [ "$i" -lt "$n" ]; do parts="$parts $C/$i"; i=$((i + 1)); done
    # shellcheck disable=SC2086,SC3040
    (set -o pipefail; cat $parts | tail -c 16777216 > /result/log.txt) || echo "log assembly failed" > /result/error
    kept=$(wc -c < /result/log.txt 2>/dev/null || echo 0)
    [ "$total" -gt "$kept" ] && echo $((total - kept)) > /result/log_skipped
    rm -rf "$C" /result/head /result/total
    [ -f /result/rc ] || echo 125 > /result/rc
fi

cd / || halt
# result + /out straight onto the raw result disk, no copies on scratch
# a run whose /out didn't make it back has failed, whatever the command returned.
# if even the small tar fails, the host finds no exit code and fails the run too
if ! tar -c -f /dev/vdd result out 2>/dev/null; then
    echo "result over the 256M cap, /out dropped" > /result/error
    tar -c -f /dev/vdd result 2>/dev/null || echo "burner-init: result disk write failed" > /dev/console
fi
halt
