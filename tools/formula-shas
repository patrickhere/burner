#!/bin/sh
# the urls and sha256s for dist/homebrew/burner.rb (and the tap's copy of it)
# for a release, once the release workflow has published it. none of them is
# just what github serves right now:
# - the tag has to point at the commit you name, the one you tagged yourself:
#   a tag fetched from github would only check github against itself
# - the source tarball has to unpack to exactly what git archive makes of that
#   commit in this checkout
# - the kernel has to be the one install.sh pins at that commit
# - the kernel and the image need build provenance from this repo's release
#   workflow, run for that tag (gh attestation verify, needs gh)
#   tools/formula-shas v0.2.0 COMMIT
set -eu
usage="usage: tools/formula-shas TAG COMMIT"
tag="${1:?$usage}"
commit="${2:?$usage}"
repo=patrickhere/burner
src="$(cd "$(dirname "$0")/.." && pwd)"

die() { echo "formula-shas: $*" >&2; exit 1; }
get() { curl -fsSL --proto '=https' --retry 3 -o "$2" "$1" || die "download failed: $1"; }
sha() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

command -v gh >/dev/null 2>&1 || die "needs gh, for gh attestation verify"
want=$(git -C "$src" rev-parse -q --verify "$commit^{commit}") || die "no commit $commit in $src"
have=$(git -C "$src" rev-parse -q --verify "refs/tags/$tag^{commit}") || die "no tag $tag in $src"
[ "$have" = "$want" ] || die "tag $tag is $have here, not $want"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

tarball="https://github.com/$repo/archive/refs/tags/$tag.tar.gz"
get "$tarball" "$work/src.tar.gz"
mkdir "$work/github" "$work/tag"
tar -xzf "$work/src.tar.gz" -C "$work/github"
git -C "$src" archive --prefix=src/ "$want" | tar -xf - -C "$work/tag"
set -- "$work"/github/*
if [ $# != 1 ] || [ ! -d "$1" ]; then
    die "github's tarball for $tag isn't one directory"
fi
diff -r "$1" "$work/tag/src" >/dev/null || die "github's tarball for $tag doesn't match the tag here"

base="https://github.com/$repo/releases/download/$tag"
for f in vmlinux-aarch64 alpine-aarch64.ext4.gz; do
    get "$base/$f" "$work/$f"
    gh attestation verify "$work/$f" -R "$repo" \
        --signer-workflow "$repo/.github/workflows/release.yml" \
        --source-ref "refs/tags/$tag" --source-digest "$want" >/dev/null ||
        die "$f has no build provenance from $repo's release workflow for $tag"
done
pin=$(git -C "$src" show "$want:install.sh" | sed -n '/^    aarch64)/,/;;/s/.*KERNEL_SHA=\([0-9a-f]*\).*/\1/p')
[ "$(sha "$work/vmlinux-aarch64")" = "$pin" ] || die "the release's kernel isn't the one install.sh pins at $tag"

echo "url     $tarball"
echo "sha256  $(sha "$work/src.tar.gz")"
echo
echo "resource \"guest-kernel\""
echo "url     $base/vmlinux-aarch64"
echo "sha256  $(sha "$work/vmlinux-aarch64")"
echo
echo "resource \"alpine-image\""
echo "url     $base/alpine-aarch64.ext4.gz"
echo "sha256  $(sha "$work/alpine-aarch64.ext4.gz")"
