#!/bin/bash
# build <root>/images/NAME/rootfs.ext4 from images/NAME/Dockerfile and guest/init.
# root is $BURNER_ROOT, default /var/lib/burner. needs docker and sudo.
set -euo pipefail
name="${1:?usage: build-image NAME}"
[[ "$name" =~ ^[a-z0-9-]{1,32}$ ]] || { echo "bad image name" >&2; exit 2; }
src="$(cd "$(dirname "$0")/.." && pwd)"
root="${BURNER_ROOT:-/var/lib/burner}"
[ -f "$src/images/$name/Dockerfile" ] || { echo "no Dockerfile for $name" >&2; exit 2; }

work=$(mktemp -d /tmp/burner-build-XXXX)
trap 'sudo rm -rf "$work"; docker rm -f "burner-build-$name" >/dev/null 2>&1 || true' EXIT
cp "$src/images/$name/Dockerfile" "$src/guest/init" "$work/"
docker build -q -t "burner-img-$name:latest" "$work" >/dev/null
docker create --name "burner-build-$name" "burner-img-$name:latest" >/dev/null
mkdir "$work/root"
docker export "burner-build-$name" | sudo tar -x -C "$work/root"
sudo rm -f "$work/root/.dockerenv" "$work/root/etc/resolv.conf"
printf '127.0.0.1 localhost\n127.0.1.1 burner\n::1 localhost\n' | sudo tee "$work/root/etc/hosts" >/dev/null
echo burner | sudo tee "$work/root/etc/hostname" >/dev/null
mb=$(sudo du -sm "$work/root" | cut -f1)
truncate -s $(( mb * 13 / 10 + 64 ))M "$work/rootfs.ext4"
sudo mkfs.ext4 -q -F -L "burner-$name" -d "$work/root" "$work/rootfs.ext4"

dest="$root/images/$name"
sudo install -d -m 0755 "$dest"
sudo install -m 0644 "$work/rootfs.ext4" "$dest/rootfs.ext4.new"
sudo mv -f "$dest/rootfs.ext4.new" "$dest/rootfs.ext4"
[ -f "$src/images/$name/defaults.toml" ] && sudo install -m 0644 "$src/images/$name/defaults.toml" "$dest/defaults.toml"
echo "$name: $(du -h "$dest/rootfs.ext4" | cut -f1) ($mb M content) -> $dest"
