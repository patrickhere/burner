#!/bin/sh
# burner on a mac. burner needs linux with kvm, so on a mac it runs inside a
# lima VM with nested virtualization (an M3 or newer, macOS 15 or later).
#   burner setup             make the VM and install burner in it, once
#   burner upgrade           install the latest burner release in the VM
#   burner vm start|stop|shell|delete
#   burner <anything else>   that burner command, run in the VM as root
# burner-tui is a link to this script and opens the TUI in the VM.
# BURNER_VM picks another lima VM name, default burnervm
set -eu

VM=${BURNER_VM:-burnervm}

die() {
    printf 'burner: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
burner on a mac runs inside a linux VM (lima, with nested virtualization).

  burner setup             make the VM and install burner in it, once
  burner upgrade           install the latest burner release in the VM
  burner vm start|stop|shell|delete
  burner <command> ...     any burner command, run in the VM as root

once set up, burner --help inside the VM lists the commands:
  burner run -- 'uname -a'
  burner shell alpine
EOF
}

state() {
    limactl list --format '{{.Status}}' "$VM" 2>/dev/null || true
}

check_mac() {
    command -v limactl >/dev/null 2>&1 || die "needs lima: brew install lima"
    [ "$(uname -m)" = arm64 ] || die "needs an apple silicon mac, an M3 or newer"
    v=$(sw_vers -productVersion)
    [ "${v%%.*}" -ge 15 ] || die "needs macOS 15 or later for nested virtualization, this is $v"
    chip=$(sysctl -n machdep.cpu.brand_string)
    case "$chip" in
        *M1* | *M2*) die "the $chip can't pass kvm through to a VM, burner needs an M3 or newer" ;;
    esac
}

# start the VM if it's there and stopped; quiet, lima is chatty
up() {
    case "$(state)" in
        Running) ;;
        "") die "no burner VM yet, run: burner setup" ;;
        *) limactl start --tty=false "$VM" >/dev/null 2>&1 || die "the $VM VM didn't start, try: limactl start $VM" ;;
    esac
}

setup() {
    check_mac
    case "$(state)" in
        Running) ;;
        "")
            printf 'burner: making the %s VM (ubuntu 24.04, a few minutes the first time)\n' "$VM"
            limactl start --tty=false --name="$VM" --vm-type=vz --cpus=4 --memory=6 --disk=40 \
                --set '.nestedVirtualization=true' template:ubuntu-24.04 >/dev/null 2>&1 \
                || die "lima couldn't make the VM, see: limactl start --name=$VM template:ubuntu-24.04"
            ;;
        *) up ;;
    esac
    limactl shell --workdir / "$VM" -- test -e /dev/kvm \
        || die "the VM has no /dev/kvm, so this mac can't run burner (needs an M3 or newer, macOS 15 or later)"
    limactl shell --workdir / "$VM" -- sh -c 'curl -fsSL https://get.burnervm.dev | sh'
    # the installer's examples use sudo, which on the mac side this script adds
    printf '  on this mac, the same commands without sudo:\n'
    printf "    burner run -- 'uname -a'\n    burner shell alpine\n    burner-tui\n\n"
}

if [ "$(basename "$0")" = burner-tui ]; then
    up
    exec limactl shell --workdir / "$VM" -- burner-tui "$@"
fi

case "${1:-}" in
    "" | -h | --help) usage ;;
    setup) setup ;;
    upgrade)
        up
        exec limactl shell --workdir / "$VM" -- sh -c 'curl -fsSL https://get.burnervm.dev | sh'
        ;;
    vm)
        case "${2:-}" in
            start) up ;;
            stop) limactl stop "$VM" ;;
            shell)
                up
                exec limactl shell "$VM"
                ;;
            delete) limactl delete --force "$VM" ;;
            *) die "usage: burner vm start|stop|shell|delete" ;;
        esac
        ;;
    *)
        up
        exec limactl shell --workdir / "$VM" -- sudo burner "$@"
        ;;
esac
