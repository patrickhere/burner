# let one user run burner VMs and nothing else. sudo ./install.sh --allow alice
# writes this rule to /etc/sudoers.d/burner and checks it. to do it by hand,
# copy this there, replace alice, then check it with:
#   sudo visudo -cf /etc/sudoers.d/burner
#
# through sudo, burner only takes configs from /etc/burner and burner kill only
# stops VMs that caller started and burner log only shows their own runs.
# doctor and explain are there without --probe and --rules: --probe boots VMs
# that try what a VM must not reach here, and --rules shows this host's whole
# firewall. net, reap, setup and config stay root's.
# burner -H from another machine, ssh'd in as alice, needs this same rule.
alice ALL=(root) NOPASSWD: /usr/local/bin/burner run *, /usr/local/bin/burner shell, \
    /usr/local/bin/burner shell *, /usr/local/bin/burner ls, /usr/local/bin/burner ls *, \
    /usr/local/bin/burner kill *, /usr/local/bin/burner images, /usr/local/bin/burner images --json, \
    /usr/local/bin/burner log, /usr/local/bin/burner log *, /usr/local/bin/burner doctor, \
    /usr/local/bin/burner doctor --json, /usr/local/bin/burner explain, /usr/local/bin/burner explain --json
